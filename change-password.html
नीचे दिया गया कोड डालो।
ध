
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Change Password - Sirauli Dairy</title>
  <link rel="stylesheet" href="./style.css">
  <style>
    .password-card {
      max-width: 440px;
      margin: 30px auto;
      padding: 24px;
      border-radius: 18px;
      background: #202020;
      color: #fff;
      box-shadow: 0 8px 24px rgba(0,0,0,.2);
    }
    .password-card h2 {
      text-align: center;
      color: #91df9b;
      margin-bottom: 8px;
    }
    .password-card .subtitle {
      text-align: center;
      color: #bdbdbd;
      margin-bottom: 24px;
    }
    .password-card label {
      display: block;
      margin: 16px 0 8px;
      font-weight: 600;
    }
    .password-card input {
      box-sizing: border-box;
      width: 100%;
      padding: 14px;
      border: 1px solid #505050;
      border-radius: 10px;
      background: #292929;
      color: #fff;
      font-size: 16px;
    }
    .password-card button {
      width: 100%;
      padding: 14px;
      margin-top: 20px;
      border: 0;
      border-radius: 10px;
      background: #08751b;
      color: #fff;
      font-size: 16px;
      cursor: pointer;
    }
    .password-card .back-button {
      background: #343434;
      margin-top: 10px;
    }
    #message {
      text-align: center;
      margin-top: 14px;
    }
  </style>
</head>
<body>
  <div class="container password-card">
    <h2>🔐 Change Password</h2>
    <p class="subtitle">Secure your Sirauli Dairy admin account</p>

    <label for="oldPassword">Current Password</label>
    <input type="password" id="oldPassword"
           placeholder="Enter current password" autocomplete="current-password">

    <label for="newPassword">New Password</label>
    <input type="password" id="newPassword"
           placeholder="Enter new password" autocomplete="new-password">

    <label for="confirmPassword">Confirm New Password</label>
    <input type="password" id="confirmPassword"
           placeholder="Re-enter new password" autocomplete="new-password">

    <button type="button" onclick="alert('Password update will be connected next.')">
      Update Password
    </button>
    <button type="button" class="back-button"
            onclick="location.href='dashboard.html'">
      ← Back to Dashboard
    </button>
    <p id="message"></p>
  </div>
</body>
</html>
